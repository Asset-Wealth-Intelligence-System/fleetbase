<Modal::Default @modalIsOpened={{@modalIsOpened}} @options={{@options}} @confirm={{@onConfirm}} @decline={{@onDecline}}>
    <div class="modal-body-container">
        <InputGroup @name={{t "literal.console.dashboard-name"}} @value={{@options.name}} @helpText={{t "literal.console.enter-the-name-of-your-dashboard"}} />
    </div>
</Modal::Default>