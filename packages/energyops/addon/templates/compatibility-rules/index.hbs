<Layout::Resource::Tabular
    @resource="energy-compatibility-rule"
    @controller={{this}}
    @title={{t "energyops.nav.compatibility"}}
    @data={{@model}}
    @columns={{this.columns}}
    @actionButtons={{this.actionButtons}}
    @bulkActions={{this.bulkActions}}
    @searchQuery={{this.query}}
    @onSearch={{perform this.compatibilityRuleActions.controllerSearchTask this}}
    @page={{this.page}}
    @onPageChange={{fn (mut this.page)}}
    @emptyStateTitle={{t "energyops.nav.compatibility"}}
    @emptyStateDescription={{t "energyops.compatibility.help"}}
    @emptyStateIcon="shuffle"
    @emptyStateAction={{hash label=(t "common.new") onClick=this.compatibilityRuleActions.transition.create}}
/>
{{outlet}}
