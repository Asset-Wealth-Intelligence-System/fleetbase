<Layout::Resource::Panel
    @resource={{@model}}
    @controller={{this}}
    @authSchema="energy-ops"
    @headerTitle={{@model.displayName}}
    @actionButtons={{this.actionButtons}}
    @onPressCancel={{transition-to "compatibility-rules.index"}}
    @onOverlayReady={{fn (mut this.overlay)}}
>
    <EnergyCompatibilityRule::Details @resource={{@model}} @controller={{this}} />
    <Spacer @height="200px" />
</Layout::Resource::Panel>