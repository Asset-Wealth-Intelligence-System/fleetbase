<Layout::Resource::Panel
    @resource={{this.rule}}
    @controller={{this}}
    @authSchema="energy-ops"
    @headerTitle={{t "common.create-a-new-resource" resource=(lowercase (t "energyops.resource.compatibility-rule"))}}
    @saveTask={{this.save}}
    @onPressCancel={{transition-to "compatibility-rules.index"}}
    @onOverlayReady={{fn (mut this.overlay)}}
>
    <EnergyCompatibilityRule::Form @resource={{this.rule}} @controller={{this}} />
    <Spacer @height="200px" />
</Layout::Resource::Panel>