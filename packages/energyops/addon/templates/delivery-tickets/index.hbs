<Layout::Resource::Tabular
    @resource="energy-delivery-ticket"
    @controller={{this}}
    @title={{t "energyops.nav.delivery-tickets"}}
    @data={{@model}}
    @columns={{this.columns}}
    @actionButtons={{this.actionButtons}}
    @bulkActions={{this.bulkActions}}
    @searchQuery={{this.query}}
    @onSearch={{perform this.deliveryTicketActions.controllerSearchTask this}}
    @page={{this.page}}
    @onPageChange={{fn (mut this.page)}}
    @emptyStateTitle={{t "energyops.nav.delivery-tickets"}}
    @emptyStateDescription={{t "energyops.ticket.empty-help"}}
    @emptyStateIcon="receipt"
    @emptyStateAction={{hash label=(t "energyops.ticket.issue") onClick=this.deliveryTicketActions.transition.create}}
/>
{{outlet}}
