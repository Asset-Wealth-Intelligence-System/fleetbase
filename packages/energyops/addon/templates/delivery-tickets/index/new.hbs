<Layout::Resource::Panel
    @resource={{this.ticket}}
    @controller={{this}}
    @authSchema="energy-ops"
    @headerTitle={{t "common.create-a-new-resource" resource=(lowercase (t "energyops.resource.delivery-ticket"))}}
    @saveTask={{this.save}}
    @onPressCancel={{transition-to "delivery-tickets.index"}}
    @onOverlayReady={{fn (mut this.overlay)}}
>
    <EnergyDeliveryTicket::Form @resource={{this.ticket}} @controller={{this}} />
    <Spacer @height="200px" />
</Layout::Resource::Panel>