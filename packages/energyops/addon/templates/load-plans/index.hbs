<Layout::Resource::Tabular
    @resource="energy-load-plan"
    @controller={{this}}
    @title={{t "energyops.nav.load-plans"}}
    @data={{@model}}
    @columns={{this.columns}}
    @actionButtons={{this.actionButtons}}
    @bulkActions={{this.bulkActions}}
    @searchQuery={{this.query}}
    @onSearch={{perform this.loadPlanActions.controllerSearchTask this}}
    @page={{this.page}}
    @onPageChange={{fn (mut this.page)}}
    @emptyStateTitle={{t "energyops.nav.load-plans"}}
    @emptyStateDescription={{t "energyops.load-plan.pack-help"}}
    @emptyStateIcon="clipboard-list"
    @emptyStateAction={{hash label=(t "energyops.load-plan.pack-orders") onClick=this.loadPlanActions.packOrders}}
/>
{{outlet}}
