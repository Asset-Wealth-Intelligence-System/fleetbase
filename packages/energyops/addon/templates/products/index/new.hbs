<Layout::Resource::Panel
    @resource={{this.product}}
    @controller={{this}}
    @authSchema="energy-ops"
    @headerTitle={{t "common.create-a-new-resource" resource=(lowercase (t "energyops.resource.product"))}}
    @saveTask={{this.save}}
    @onPressCancel={{transition-to "products.index"}}
    @onOverlayReady={{fn (mut this.overlay)}}
>
    <EnergyProduct::Form @resource={{this.product}} @controller={{this}} />
    <Spacer @height="200px" />
</Layout::Resource::Panel>