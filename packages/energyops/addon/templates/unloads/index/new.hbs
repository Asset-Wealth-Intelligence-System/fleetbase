<Layout::Resource::Panel
    @resource={{this.draft}}
    @pojoResource={{true}}
    @controller={{this}}
    @authSchema="energy-ops"
    @headerTitle={{t "energyops.unload.register"}}
    @actionButtons={{this.actionButtons}}
    @onPressCancel={{transition-to "unloads.index"}}
    @onOverlayReady={{fn (mut this.overlay)}}
>
    <EnergyUnload::Form @resource={{this.draft}} @controller={{this}} />
    <Spacer @height="200px" />
</Layout::Resource::Panel>
