<Layout::Resource::Panel
    @resource={{this.operation}}
    @controller={{this}}
    @authSchema="energy-ops"
    @headerTitle={{t "common.create-a-new-resource" resource=(lowercase (t "energyops.resource.operation"))}}
    @saveTask={{this.save}}
    @onPressCancel={{transition-to "operations.index"}}
    @onOverlayReady={{fn (mut this.overlay)}}
>
    <EnergyOperation::Form @resource={{this.operation}} @controller={{this}} />
    <Spacer @height="200px" />
</Layout::Resource::Panel>