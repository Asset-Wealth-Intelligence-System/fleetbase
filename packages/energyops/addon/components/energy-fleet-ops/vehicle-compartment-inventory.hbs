{{#if this.canSee}}
    <ContentPanel
        @title={{t "energyops.fleet-ops.vehicle-panel-title"}}
        @titleIcon="gas-pump"
        @open={{true}}
        @wrapperClass="bordered-top"
        @actionButtons={{this.panelActionButtons}}
        ...attributes
    >
        {{#if this.load.isRunning}}
            <div class="flex items-center justify-center py-6"><Spinner /></div>
        {{else if this.compartments.length}}
            <div class="text-xs text-gray-500 mb-2">
                {{#if this.profile.operation}}<span class="mr-3">{{t "energyops.load-plan.fields.operation"}}: <span class="font-semibold">{{this.profile.operation.name}}</span></span>{{/if}}
                {{#if this.profile.is_tractor}}<Badge @status="info" @hideStatusDot={{true}}>{{t "energyops.vehicle-profile.fields.is-tractor"}}</Badge>{{/if}}
            </div>
            <EnergyCompartment::Schematic @compartments={{this.compartments}} @owner={{this.compartmentOwner}} />
            <EnergyCompartment::Inventory @compartments={{this.compartments}} class="mt-3" />
        {{else}}
            <p class="text-xs text-gray-500">{{t "energyops.fleet-ops.no-compartments"}}</p>
        {{/if}}
    </ContentPanel>
{{/if}}
