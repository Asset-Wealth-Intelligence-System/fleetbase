<div class="p-4 space-y-4 text-xs">
    <p class="text-gray-500">{{t "energyops.load-plan.pack-help"}}</p>

    <InputGroup @name={{t "energyops.load-plan.orders"}}>
        <ModelSelect
            @modelName="order"
            @query={{hash status="created,pending,planned" sort="-created_at"}}
            @placeholder={{t "energyops.common.select-order"}}
            @triggerClass="form-select form-input"
            @infiniteScroll={{false}}
            @renderInPlace={{true}}
            @onChange={{this.addOrder}}
            as |model|
        >
            <span class="font-mono font-semibold">{{model.public_id}}</span>
            <span class="text-gray-500 ml-2">{{model.tracking_number.tracking_number}} · {{model.status}}</span>
        </ModelSelect>
        <div class="flex flex-wrap gap-1 mt-2">
            {{#each this.selection.orders as |order|}}
                <span class="inline-flex items-center px-2 py-0.5 rounded bg-blue-50 dark:bg-blue-900 text-blue-700 dark:text-blue-100">
                    <span class="font-mono">{{order.public_id}}</span>
                    <button type="button" class="ml-1 hover:text-red-500" {{on "click" (fn this.removeOrder order)}}><FaIcon @icon="times" @size="xs" /></button>
                </span>
            {{/each}}
        </div>
    </InputGroup>

    <InputGroup @name={{t "energyops.load-plan.fields.depot-optional"}} @helpText={{t "energyops.load-plan.pack-depot-help"}}>
        <ModelSelect
            @modelName="place"
            @selectedModel={{this.selection.depot}}
            @query={{hash type="depot"}}
            @placeholder={{t "energyops.common.select-depot"}}
            @triggerClass="form-select form-input"
            @infiniteScroll={{false}}
            @renderInPlace={{true}}
            @allowClear={{true}}
            @onChange={{this.setDepot}}
            as |model|
        >
            <span class="font-semibold">{{model.name}}</span> <span class="text-gray-500 ml-1">{{model.address}}</span>
        </ModelSelect>
    </InputGroup>

    <InputGroup @name={{t "energyops.load-plan.vehicles"}}>
        <ModelSelect
            @modelName="vehicle"
            @placeholder={{t "energyops.common.select-vehicle"}}
            @triggerClass="form-select form-input"
            @infiniteScroll={{false}}
            @renderInPlace={{true}}
            @onChange={{this.addVehicle}}
            as |model|
        >
            {{or model.displayName model.display_name model.name}}
        </ModelSelect>
        <div class="flex flex-wrap gap-1 mt-2">
            {{#each this.selection.vehicles as |vehicle|}}
                <span class="inline-flex items-center px-2 py-0.5 rounded bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-100">
                    {{or vehicle.displayName vehicle.display_name vehicle.name}}
                    <button type="button" class="ml-1 hover:text-red-500" {{on "click" (fn this.removeVehicle vehicle)}}><FaIcon @icon="times" @size="xs" /></button>
                </span>
            {{/each}}
        </div>
    </InputGroup>
</div>
