<div class="details-wrapper" ...attributes>
    <ContentPanel @title={{t "common.details"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-2 text-xs dark:text-gray-100">
            <div class="field-info-container">
                <div class="field-name">{{t "column.id"}}</div>
                <div class="field-value"><ClickToCopy @value={{this.resource.public_id}}>{{this.resource.public_id}}</ClickToCopy></div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "energyops.common.status"}}</div>
                <div class="field-value"><Badge @status={{this.resource.status}} /></div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "energyops.unload.fields.vehicle"}}</div>
                <div class="field-value">
                    {{#if this.resource.vehicle}}
                        <a href="javascript:;" class="text-blue-500 hover:underline" {{on "click" (fn (transition-to "fleet.index.details" this.resource.vehicle))}}>{{this.resource.vehicleName}}</a>
                    {{else}}
                        -
                    {{/if}}
                </div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "energyops.unload.fields.driver"}}</div>
                <div class="field-value">{{n-a this.resource.driverName}}</div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "energyops.unload.fields.inventory-place"}}</div>
                <div class="field-value">{{n-a this.resource.inventoryPlaceName}}</div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "energyops.unload.fields.load-plan"}}</div>
                <div class="field-value">
                    {{#if this.resource.load_plan.public_id}}
                        <a href="javascript:;" class="font-mono text-blue-500 hover:underline" {{on "click" (fn (transition-to "load-plans.index.details" this.resource.load_plan.public_id))}}>{{this.resource.load_plan.public_id}}</a>
                    {{else}}
                        -
                    {{/if}}
                </div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "energyops.unload.fields.before"}}</div>
                <div class="field-value font-mono">{{format-number this.resource.total_before_volume maximumFractionDigits=1}} {{this.resource.unit}}</div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "energyops.unload.fields.unloaded"}}</div>
                <div class="field-value font-mono">{{format-number this.resource.total_unloaded_volume maximumFractionDigits=1}} {{this.resource.unit}}</div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "energyops.unload.fields.remaining"}}</div>
                <div class="field-value font-mono">{{format-number this.resource.total_remaining_volume maximumFractionDigits=1}} {{this.resource.unit}}</div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "energyops.unload.fields.unloaded-at"}}</div>
                <div class="field-value">{{n-a this.resource.unloadedAt}}</div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "energyops.unload.fields.created-at"}}</div>
                <div class="field-value">{{n-a this.resource.createdAt}}</div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "energyops.unload.fields.confirmed-at"}}</div>
                <div class="field-value">{{n-a this.resource.confirmedAt}}</div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "energyops.unload.fields.source"}}</div>
                <div class="field-value">{{n-a this.resource.source}}</div>
            </div>
            <div class="field-info-container lg:col-span-2">
                <div class="field-name">{{t "energyops.common.notes"}}</div>
                <div class="field-value">{{n-a this.resource.notes}}</div>
            </div>
        </div>
    </ContentPanel>

    <ContentPanel @title={{t "energyops.unload.lines"}} @open={{true}} @wrapperClass="bordered-top mt-4">
        {{#if this.lines.length}}
            <table class="energy-table w-full text-xs">
                <thead>
                    <tr class="text-left text-gray-500">
                        <th class="py-1 pr-2">{{t "energyops.common.sequence"}}</th>
                        <th class="py-1 pr-2">{{t "energyops.resource.compartment"}}</th>
                        <th class="py-1 pr-2">{{t "energyops.resource.product"}}</th>
                        <th class="py-1 pr-2 text-right">{{t "energyops.unload.fields.before"}}</th>
                        <th class="py-1 pr-2 text-right">{{t "energyops.unload.fields.unloaded"}}</th>
                        <th class="py-1 text-right">{{t "energyops.unload.fields.remaining"}}</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100 dark:divide-gray-800">
                    {{#each this.lines as |line|}}
                        <tr>
                            <td class="py-1 pr-2 font-mono">{{line.sequence}}</td>
                            <td class="py-1 pr-2 font-semibold">{{n-a line.compartmentCode}}</td>
                            <td class="py-1 pr-2">{{n-a line.productName}}</td>
                            <td class="py-1 pr-2 text-right font-mono">{{format-number line.before_volume maximumFractionDigits=1}}</td>
                            <td class="py-1 pr-2 text-right font-mono">{{format-number line.unloaded_volume maximumFractionDigits=1}}</td>
                            <td class="py-1 text-right font-mono {{if (gt line.remaining_volume 0) 'text-yellow-600'}}">{{format-number line.remaining_volume maximumFractionDigits=1}}</td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        {{else}}
            <p class="text-xs text-gray-500">{{t "energyops.unload.no-lines"}}</p>
        {{/if}}
    </ContentPanel>

    <ContentPanel @title={{t "energyops.unload.proof.title"}} @open={{true}} @wrapperClass="bordered-top mt-4">
        <EnergyFleetOps::ProofFiles @files={{this.resource.proofFiles}} @emptyText={{t "energyops.unload.proof.none"}} />
    </ContentPanel>
</div>
