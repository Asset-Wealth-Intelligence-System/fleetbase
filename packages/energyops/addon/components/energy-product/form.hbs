<div class="form-wrapper" ...attributes>
    <ContentPanel @title={{t "common.details"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-1 gap-2 lg:grid-cols-2 lg:gap-2 no-input-group-padding text-xs">
            <InputGroup @name={{t "energyops.product.fields.operation"}} @wrapperClass="col-span-2" @required={{true}}>
                <ModelSelect
                    @modelName="energy-operation"
                    @selectedModel={{this.resource.operation}}
                    @placeholder={{t "energyops.common.select-operation"}}
                    @triggerClass="form-select form-input"
                    @infiniteScroll={{false}}
                    @renderInPlace={{true}}
                    @onChange={{this.setOperation}}
                    @disabled={{cannot-write this.resource schema="energy-ops"}}
                    as |model|
                >
                    <span class="font-semibold">{{model.code}}</span> <span class="text-gray-500 ml-1">{{model.name}}</span>
                </ModelSelect>
            </InputGroup>
            <InputGroup @name={{t "energyops.product.fields.code"}} @required={{true}}>
                <Input @value={{this.resource.code}} @type="text" class="w-full form-input uppercase" placeholder={{t "energyops.product.fields.code-placeholder"}} disabled={{cannot-write this.resource schema="energy-ops"}} />
            </InputGroup>
            <InputGroup @name={{t "energyops.common.name"}} @required={{true}}>
                <Input @value={{this.resource.name}} @type="text" class="w-full form-input" placeholder={{t "energyops.product.fields.name-placeholder"}} disabled={{cannot-write this.resource schema="energy-ops"}} />
            </InputGroup>
            <InputGroup @name={{t "energyops.product.fields.description"}} @wrapperClass="col-span-2">
                <Textarea @value={{this.resource.description}} class="w-full form-input" rows="2" disabled={{cannot-write this.resource schema="energy-ops"}} />
            </InputGroup>
            <InputGroup @name={{t "energyops.product.fields.density"}} @helpText={{t "literal.energyops.used-to-convert-kg-l-when-packing-compartments"}}>
                <Input @value={{this.resource.density}} @type="number" step="0.001" min="0" class="w-full form-input" disabled={{cannot-write this.resource schema="energy-ops"}} />
            </InputGroup>
            <InputGroup @name={{t "energyops.product.fields.default-unit"}}>
                <Select @options={{this.unitOptions}} @value={{this.resource.default_unit}} @onSelect={{fn (mut this.resource.default_unit)}} @placeholder={{t "energyops.common.unit"}} @disabled={{cannot-write this.resource schema="energy-ops"}} class="w-full" />
            </InputGroup>
            <InputGroup @name={{t "energyops.product.fields.un-number"}}>
                <Input @value={{this.resource.un_number}} @type="text" class="w-full form-input" placeholder="UN1075" disabled={{cannot-write this.resource schema="energy-ops"}} />
            </InputGroup>
            <InputGroup @name={{t "energyops.product.fields.hazmat-class"}}>
                <Select
                    @options={{this.hazmatOptions}}
                    @optionLabel="label"
                    @optionValue="value"
                    @value={{this.resource.hazmat_class}}
                    @onSelect={{fn (mut this.resource.hazmat_class)}}
                    @placeholder={{t "energyops.product.fields.hazmat-class"}}
                    @disabled={{cannot-write this.resource schema="energy-ops"}}
                    class="w-full"
                />
            </InputGroup>
            <InputGroup @name={{t "energyops.product.fields.skill"}} @helpText={{t "energyops.product.fields.skill-help"}}>
                <Input @value={{this.resource.skill}} @type="text" class="w-full form-input" placeholder="propane" disabled={{cannot-write this.resource schema="energy-ops"}} />
            </InputGroup>
            <InputGroup @name={{t "energyops.product.fields.color"}}>
                <div class="flex items-center space-x-2">
                    <input type="color" value={{or this.resource.color "#2563eb"}} {{on "input" this.setColor}} class="form-input h-9 w-14 p-1" disabled={{cannot-write this.resource schema="energy-ops"}} />
                    <Input @value={{this.resource.color}} @type="text" class="w-full form-input" placeholder="#2563eb" disabled={{cannot-write this.resource schema="energy-ops"}} />
                </div>
            </InputGroup>
            <InputGroup @name={{t "energyops.common.status"}}>
                <Select @options={{this.statusOptions}} @value={{this.resource.status}} @onSelect={{fn (mut this.resource.status)}} @placeholder={{t "energyops.common.status"}} @disabled={{cannot-write this.resource schema="energy-ops"}} class="w-full" />
            </InputGroup>
            <div class="flex items-end pb-1">
                <Toggle @isToggled={{this.resource.active}} @onToggle={{fn this.toggle "active"}} @label={{t "energyops.product.fields.active"}} @disabled={{cannot-write this.resource schema="energy-ops"}} />
            </div>
        </div>
    </ContentPanel>
</div>
