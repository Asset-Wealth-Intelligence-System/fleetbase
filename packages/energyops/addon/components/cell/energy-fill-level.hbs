<div class="flex items-center space-x-2 w-full">
    <div class="flex-1 h-2 rounded bg-gray-200 dark:bg-gray-700 overflow-hidden">
        <div class="h-2 rounded {{if (gt @value 85) 'bg-red-500' (if (gt @value 50) 'bg-green-500' (if (gt @value 20) 'bg-yellow-500' 'bg-red-400'))}}" style={{html-safe (concat "width:" (or @value 0) "%")}}></div>
    </div>
    <span class="text-xs text-gray-500 w-9 text-right">{{or @value 0}}%</span>
</div>
