<div class="details-wrapper" ...attributes>
    <ContentPanel @title={{t "common.details"}} @open={{true}} @wrapperClass="bordered-top">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-2 text-xs dark:text-gray-100">
            <div class="field-info-container">
                <div class="field-name">{{t "energyops.operation.fields.code"}}</div>
                <div class="field-value">{{n-a this.resource.code}}</div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "energyops.common.name"}}</div>
                <div class="field-value">{{n-a this.resource.name}}</div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "energyops.operation.fields.family"}}</div>
                <div class="field-value"><Badge @status={{this.resource.family}} /></div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "energyops.operation.fields.unit"}}</div>
                <div class="field-value">{{n-a this.resource.unit}}</div>
            </div>
            <div class="field-info-container col-span-2">
                <div class="field-name">{{t "energyops.operation.fields.depot"}}</div>
                <div class="field-value">{{n-a this.resource.depotName}}</div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "energyops.operation.fields.service-seconds"}}</div>
                <div class="field-value">{{n-a this.resource.default_service_seconds}}</div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "energyops.common.status"}}</div>
                <div class="field-value"><Badge @status={{this.resource.status}} /></div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "energyops.operation.fields.allow-split"}}</div>
                <div class="field-value">{{if this.resource.allow_split_delivery (t "energyops.common.yes") (t "energyops.common.no")}}</div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "energyops.operation.fields.block-over-ullage"}}</div>
                <div class="field-value">{{if this.resource.block_over_ullage (t "energyops.common.yes") (t "energyops.common.no")}}</div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "column.created-at"}}</div>
                <div class="field-value">{{n-a this.resource.createdAt}}</div>
            </div>
            <div class="field-info-container">
                <div class="field-name">{{t "column.id"}}</div>
                <div class="field-value"><ClickToCopy @value={{this.resource.public_id}}>{{this.resource.public_id}}</ClickToCopy></div>
            </div>
        </div>
    </ContentPanel>

    <ContentPanel
        @title={{t "energyops.operation.products"}}
        @open={{true}}
        @wrapperClass="bordered-top mt-4"
        @actionButtons={{array (hash type="primary" size="xs" icon="plus" text=(t "common.new") permission="energy-ops create energy-product" onClick=(fn this.productActions.panel.create (hash operation=this.resource operation_uuid=this.resource.id) (hash callback=(perform this.loadProducts))))}}
    >
        {{#if this.loadProducts.isRunning}}
            <Spinner />
        {{else if this.products.length}}
            <div class="divide-y divide-gray-200 dark:divide-gray-700 text-xs">
                {{#each this.products as |product|}}
                    <a href="javascript:;" class="flex items-center justify-between py-2 px-1 hover:bg-gray-50 dark:hover:bg-gray-800" {{on "click" (fn this.productActions.panel.view product)}}>
                        <div class="flex items-center space-x-2">
                            <span class="inline-block w-3 h-3 rounded-full" style={{html-safe (concat "background:" (or product.color "#94a3b8"))}}></span>
                            <span class="font-semibold">{{product.code}}</span>
                            <span class="text-gray-500">{{product.name}}</span>
                        </div>
                        <div class="flex items-center space-x-2 text-gray-500">
                            <span>{{product.density}} {{t "literal.energyops.kg-l"}}</span>
                            <Badge @status={{product.status}} />
                        </div>
                    </a>
                {{/each}}
            </div>
        {{else}}
            <p class="text-xs text-gray-500">{{t "energyops.operation.no-products"}}</p>
        {{/if}}
    </ContentPanel>
</div>
